# Kopie dieser Datei als ".env" anlegen und Werte eintragen.
# Die echte .env wird NICHT eingecheckt (siehe .gitignore).

# OPTIONAL: nur nötig, wenn die App NICHT über die lokale Claude-Code-CLI laufen soll.
# Leer lassen = App nutzt "claude -p" (Max-Abo) statt der API.
ANTHROPIC_API_KEY=

# Figma Personal Access Token (figd_...) – für die Figma-Vorlagen-Routen.
# Optional, ohne Token sind /figma-Routen deaktiviert.
FIGMA_TOKEN=
